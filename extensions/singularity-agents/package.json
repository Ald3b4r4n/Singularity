{
  "name": "singularity-agents",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "singularity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:singularity.agents.editor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "singularityAgents",
          "title": "%container.title%",
          "icon": "media/agents.svg"
        }
      ]
    },
    "views": {
      "singularityAgents": [
        {
          "type": "webview",
          "id": "singularity.agents.sessions",
          "name": "%view.name%",
          "icon": "media/agents.svg",
          "contextualTitle": "%container.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "singularity.remote.enable",
        "title": "Ativar acesso remoto (celular)",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.disable",
        "title": "Desativar acesso remoto",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.pair",
        "title": "Parear dispositivo Android",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.profiles",
        "title": "Perfis de teste do acesso remoto",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.requests",
        "title": "Registro de envios remotos",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.devices",
        "title": "Dispositivos pareados",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.authorizeWorkspace",
        "title": "Workspaces do acesso remoto",
        "category": "Singularity"
      },
      {
        "command": "singularity.remote.tailscale",
        "title": "Rede privada do acesso remoto (Tailscale)",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.processes",
        "title": "Processos do Hub",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.executionPolicy",
        "title": "Modo de execução do Implementador (terminal)",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.usage",
        "title": "Uso e limites dos serviços",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.manageProviders",
        "title": "Gerenciar provedores",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.open",
        "title": "%command.open%",
        "category": "Singularity"
      },
      {
        "command": "singularity.agents.openSettings",
        "title": "%command.openSettings%",
        "category": "Singularity"
      },
      {
        "command": "singularity.hub.start",
        "title": "%command.hubStart%",
        "category": "Singularity"
      },
      {
        "command": "singularity.hub.stop",
        "title": "%command.hubStop%",
        "category": "Singularity"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "singularity.agents.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStatusBarItem%"
        },
        "singularity.agents.hub.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoStart%"
        },
        "singularity.agents.hub.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.nodePath%"
        }
      }
    }
  }
}
