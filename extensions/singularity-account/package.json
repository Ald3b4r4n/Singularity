{
  "name": "singularity-account",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "singularity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "singularity.account.signIn",
        "title": "%command.signIn%",
        "category": "Singularity"
      },
      {
        "command": "singularity.account.signOut",
        "title": "%command.signOut%",
        "category": "Singularity"
      },
      {
        "command": "singularity.account.switch",
        "title": "%command.switch%",
        "category": "Singularity"
      },
      {
        "command": "singularity.account.manage",
        "title": "%command.manage%",
        "category": "Singularity"
      },
      {
        "command": "singularity.publish.now",
        "title": "%command.publishNow%",
        "category": "Singularity"
      },
      {
        "command": "singularity.account.authorizePublish",
        "title": "%command.authorizePublish%",
        "category": "Singularity"
      },
      {
        "command": "singularity.account.revokePublish",
        "title": "%command.revokePublish%",
        "category": "Singularity"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "singularity.account.githubClientId": {
          "type": "string",
          "default": "Ov23li7YnPUKuiSrwRCh",
          "scope": "machine",
          "description": "%configuration.githubClientId%"
        },
        "singularity.publish.defaultMode": {
          "type": "string",
          "enum": [
            "manual",
            "assisted"
          ],
          "default": "manual",
          "scope": "machine",
          "enumDescriptions": [
            "%publish.mode.manual%",
            "%publish.mode.assisted%"
          ],
          "description": "%publish.defaultMode%"
        },
        "singularity.publish.automaticRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "%publish.automaticRepositories%"
        }
      }
    }
  }
}
