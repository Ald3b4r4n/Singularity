	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#7F8499"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python"
			],
			"settings": {
				"foreground": "#AEBBFF"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.brace"
			],
			"settings": {
				"foreground": "#A4AABD"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#8FD3B6"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.regexp",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#FF9E7A"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#FFB45E"
			}
		},
		{
			"scope": [
				"constant",
				"support.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#F2A27B"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.namespace",
				"storage.type.cs",
				"storage.type.kotlin"
			],
			"settings": {
				"foreground": "#9CC4FF"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#E8EAF2"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other.readwrite",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#D5D9E6"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"meta.object-literal.key",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#C4CBE0"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#AEBBFF"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#9CC4FF"
			}
		},
		{
			"scope": [
				"meta.annotation",
				"storage.type.annotation",
				"entity.name.decorator",
				"meta.decorator"
			],
			"settings": {
				"foreground": "#F2A27B"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#FFB45E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#E8EAF2",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#E8EAF2",
