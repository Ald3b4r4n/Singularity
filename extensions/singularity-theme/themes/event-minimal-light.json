	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#625F6B"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python"
			],
			"settings": {
				"foreground": "#4B55C9"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.brace"
			],
			"settings": {
				"foreground": "#55535E"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#157A52"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.regexp",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#B4430B"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#A64E05"
			}
		},
		{
			"scope": [
				"constant",
				"support.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#B4430B"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.namespace",
				"storage.type.cs",
				"storage.type.kotlin"
			],
			"settings": {
				"foreground": "#2B5CC4"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#1C1B22"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other.readwrite",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#2B2A33"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"meta.object-literal.key",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#3A3846"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#4B55C9"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#2B5CC4"
			}
		},
		{
			"scope": [
				"meta.annotation",
				"storage.type.annotation",
				"entity.name.decorator",
				"meta.decorator"
			],
			"settings": {
				"foreground": "#B4430B"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#A64E05",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#1C1B22",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#1C1B22",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
