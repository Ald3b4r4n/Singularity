{
  "name": "singularity-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Singularity Hub: local orchestration process of the Singularity IDE (JSON-RPC 2.0 over WebSocket on 127.0.0.1).",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-force-exit --test-timeout=60000 --test-concurrency=1 \"dist/test/*.test.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
